# Copy this file to .env and fill it in. .env is read at start-up and is NOT committed to git (.gitignore).
# The same file serves both ways of running: Python (backend/app.py) and Docker (docker compose up). In Docker,
# DATABASE_URL, HOST, PORT and ASR_DATA_DIR are replaced by docker-compose.yml.
# Variables set in the real environment win over this file.

# ---------- database (PostgreSQL) ----------
# postgresql://<user>:<password>@<host>:<port>/<database>
# With docker compose (docker-compose.yml) the values below match the db container.
DATABASE_URL=postgresql://khmer_asr:change-me@localhost:5432/khmer_asr
POSTGRES_USER=khmer_asr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=khmer_asr
POSTGRES_PORT=5432

# ---------- server ----------
HOST=127.0.0.1
PORT=5100
# Signs the login cookies. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
# Empty: one is made and kept in data/secret_key.
SECRET_KEY=
# 1 when the tool is served over HTTPS
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0

# ---------- administrator (required) ----------
# Made at start-up and kept in step with these values: change the password here and restart. The administrator adds
# every other user with a default password; each user chooses their own at the first sign-in. There is no sign-up.
# ADMIN_PASSWORD must be strong: 8-12 characters, upper- and lower-case letters, a number, a special character,
# no spaces, not containing the user name (else the server does not start).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- files and model ----------
# audio files and dataset clips (the database keeps everything else)
ASR_DATA_DIR=
# Hugging Face repo id or a folder with model.safetensors, config.json, vocab.json
OMNI_ASR_MODEL=
# Hugging Face token (empty: the login of `hf auth login`)
HF_TOKEN=

# ---------- dataset cleaning ----------
CER_PASS=0.10
CER_BAD=0.50

# ---------- Docker only ----------
# db: start the PostgreSQL container with `docker compose up`. Empty: use DOCKER_DATABASE_URL instead.
COMPOSE_PROFILES=db
# the database of the backend container; empty: the db container. For a PostgreSQL installed on this computer:
# postgresql://<user>:<password>@host.docker.internal:5432/<database>
DOCKER_DATABASE_URL=
# audio files and dataset clips of the backend container; empty: a Docker volume. ./data: the same folder as the
# Python run (use this together with the same database as the Python run)
DOCKER_DATA_DIR=
# port of the web app on this computer (http://localhost:3000)
WEB_PORT=3000
# PyTorch build of the backend image: the CPU build, or for an NVIDIA GPU https://download.pytorch.org/whl/cu128
TORCH_INDEX=https://download.pytorch.org/whl/cpu
# model inside the container; empty: backend/models/Omnilingual-ASR-Khm if downloaded, else from Hugging Face
DOCKER_ASR_MODEL=
