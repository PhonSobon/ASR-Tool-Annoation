    {
      "name": "3. Audio (Upload & Crop)",
      "item": [
        {
          "name": "List audio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}audios",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios"
              ],
              "query": [
                {
                  "key": "task",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Upload audio",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseURL}}audios",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios"
              ]
            },
            "description": "Body > form-data > choose a file for the key 'audio'. Saves audioId.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "audio",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.id;",
                  "if (v !== undefined) { pm.collectionVariables.set('audioId', v); console.log('audioId =', v); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Open audio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}audios/{{audioId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios",
                "{{audioId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Autosave segments",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}audios/{{audioId}}/state",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios",
                "{{audioId}}",
                "state"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"segments\": [\n    {\n      \"start\": 0,\n      \"end\": 5,\n      \"text\": \"\"\n    }\n  ],\n  \"changed\": [\n    0\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Recut into fixed segments",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}audios/{{audioId}}/recut",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios",
                "{{audioId}}",
                "recut"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chunk_seconds\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Audio file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}audios/{{audioId}}/audio",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios",
                "{{audioId}}",
                "audio"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Waveform peaks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}audios/{{audioId}}/peaks",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios",
                "{{audioId}}",
                "peaks"
              ],
              "query": [
                {
                  "key": "buckets",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Transcribe one segment (ASR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}audios/{{audioId}}/transcribe",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios",
                "{{audioId}}",
                "transcribe"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": 0,\n  \"end\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Export one audio ZIP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}audios/{{audioId}}/export",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios",
                "{{audioId}}",
                "export"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"my_dataset\",\n  \"segments\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete audio",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseURL}}audios/{{audioId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "audios",
                "{{audioId}}"
              ]
            },
            "description": ""
          }
        },
