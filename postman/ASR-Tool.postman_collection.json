{
  "info": {
    "name": "ASR Tool - Data Annotation Platform API",
    "description": "Run '1. Login > Login' first (set username and password in the collection Variables tab). Upload audio, Create task and Import dataset save audioId, taskId and datasetId automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Run this first. Postman keeps the session cookie for 127.0.0.1.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}auth/me",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Change my password (not admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}auth/password",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "password"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current\": \"\",\n  \"new\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseURL}}auth/logout",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
