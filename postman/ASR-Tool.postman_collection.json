    {
      "name": "5. Dataset Cleaning",
      "item": [
        {
          "name": "Hub: inspect dataset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}hub/inspect",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "hub",
                "inspect"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repo\": \"user/dataset\",\n  \"token\": \"{{hfToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Hub: who am I",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}hub/whoami",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "hub",
                "whoami"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{hfToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List datasets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}datasets",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "datasets"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Import dataset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}datasets",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "datasets"
              ]
            },
            "description": "Use 'Hub: inspect dataset' first to get config, split and column names. Saves datasetId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repo\": \"user/dataset\",\n  \"config\": \"default\",\n  \"split\": \"train\",\n  \"audio_column\": \"audio\",\n  \"text_column\": \"text\",\n  \"columns\": {},\n  \"start_row\": 0,\n  \"max_rows\": 100,\n  \"batches\": 1,\n  \"check\": false,\n  \"name\": \"\",\n  \"token\": \"{{hfToken}}\",\n  \"members\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const v = j.datasets && j.datasets[0] && j.datasets[0].id;",
                  "if (v !== undefined) { pm.collectionVariables.set('datasetId', v); console.log('datasetId =', v); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Open dataset",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}datasets/{{datasetId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "datasets",
