            "url": {
              "raw": "{{baseURL}}text/normalize",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "text",
                "normalize"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"សួស្តី ១២៣\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
